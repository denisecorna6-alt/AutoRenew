# Copy to .env. Do not commit your real .env file.
ANISETTE_DOMAIN=anisette.example.com
ACME_EMAIL=admin@example.com

# Set this to the immutable RepoDigest printed by:
# docker image inspect --format '{{index .RepoDigests 0}}' dadoum/anisette-v3-server
# Example format only (replace with the real digest):
ANISETTE_IMAGE=dadoum/anisette-v3-server@sha256:REPLACE_WITH_VERIFIED_DIGEST
