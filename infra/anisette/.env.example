# Copy to .env. Do not commit your real .env file.
ANISETTE_DOMAIN=anisette.example.com
ACME_EMAIL=admin@example.com

# Use immutable RepoDigests, not mutable tags.
# Obtain the Anisette digest with:
# docker pull dadoum/anisette-v3-server
# docker image inspect --format '{{index .RepoDigests 0}}' dadoum/anisette-v3-server
ANISETTE_IMAGE=dadoum/anisette-v3-server@sha256:REPLACE_WITH_VERIFIED_DIGEST

# Obtain the Caddy digest with:
# docker pull caddy:2
# docker image inspect --format '{{index .RepoDigests 0}}' caddy:2
CADDY_IMAGE=caddy@sha256:REPLACE_WITH_VERIFIED_DIGEST
